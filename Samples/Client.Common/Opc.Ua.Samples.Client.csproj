<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Opc.Ua.Samples.Client</RootNamespace>
    <AssemblyName>Opc.Ua.Samples.Client</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The user interface free half of the OPC UA sample clients: the base class of the client models, the session helpers they share and the pumps which turn subscription callbacks into model events.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions">
      <Version>10.0.11</Version>
    </PackageReference>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client">
      <Version>$(OpcUaNetStandardVersion)</Version>
    </PackageReference>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration">
      <Version>$(OpcUaNetStandardVersion)</Version>
    </PackageReference>
  </ItemGroup>

</Project>
