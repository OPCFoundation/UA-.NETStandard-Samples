<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Opc.Ua.Sample</AssemblyName>
    <PackageId>Opc.Ua.Sample</PackageId>
    <RootNamespace>Opc.Ua.Sample</RootNamespace>
    <Description>OPC UA Sample Class Library</Description>
    <NoWarn>$(NoWarn);CA1852</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="TestData\TestDataDesign.xml" />
    <AdditionalFiles Include="TestData\TestDataDesign.csv" />
    <AdditionalFiles Include="MemoryBuffer\MemoryBufferDesign.xml" />
    <AdditionalFiles Include="MemoryBuffer\MemoryBufferDesign.csv" />
    <AdditionalFiles Include="Boiler\BoilerDesign.xml" />
    <AdditionalFiles Include="Boiler\BoilerDesign.csv" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.IdentityModel" />
  </ItemGroup>

  <!-- the composition root of the sample server registers its node managers with the
       generic host, which the sample hosting library offers on the modern targets only -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="SampleServerHosting.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48' And '$(TargetFramework)' != 'netstandard2.1'">
    <ProjectReference Include="..\Hosting\Opc.Ua.Samples.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Core" Version="$(OpcUaNetStandardVersion)" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="$(OpcUaNetStandardVersion)" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.SourceGeneration" Version="$(OpcUaNetStandardVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
