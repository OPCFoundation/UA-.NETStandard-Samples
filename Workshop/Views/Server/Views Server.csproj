<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Quickstarts.ViewsServer</RootNamespace>
    <AssemblyName>Quickstarts.ViewsServer</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\..\..\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\..\..\bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="App.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <Content Include="Model\OperationsDesign.xml" />
    <Content Include="Model\EngineeringDesign.xml" />
    <Content Include="Model\ModelDesign.xml" />
    <Content Include="Quickstarts.ViewsServer.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </Content>
    <Content Include="BuildDesign.bat" />
    <Content Include="Model\OperationsDesign.csv" />
    <Content Include="Model\EngineeringDesign.csv" />
    <Content Include="Model\ModelDesign.csv" />
    <EmbeddedResource Include="Model\Quickstarts.Views.PredefinedNodes.uanodes" />
    <EmbeddedResource Include="Model\Quickstarts.Engineering.PredefinedNodes.uanodes" />
    <EmbeddedResource Include="Model\Quickstarts.Operations.PredefinedNodes.uanodes" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Samples\ServerControls.Net4\UA Server Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server">
      <Version>2.0.158.59919-preview</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Label="Compile items now included by globbing that were not in the original project file">
    <Compile Remove="Namespaces.cs" />
    <Compile Remove="Model\Quickstarts.Operations.DataTypes.cs" />
    <Compile Remove="Model\Quickstarts.Operations.Classes.cs" />
    <Compile Remove="Model\Quickstarts.Engineering.DataTypes.cs" />
    <Compile Remove="Model\Quickstarts.Engineering.Classes.cs" />
  </ItemGroup>
</Project>