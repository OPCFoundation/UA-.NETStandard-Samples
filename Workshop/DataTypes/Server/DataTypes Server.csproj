<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Quickstarts.DataTypes</RootNamespace>
    <AssemblyName>Quickstarts.DataTypesServer</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <SignManifests>false</SignManifests>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="App.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <Content Include="DataTypesServer.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </Content>
    <!-- The instance model is compiled by the OPC UA source generator. Its BicycleType
         subtypes a structure of the type model in the DataTypes Library and its
         DriverOfTheMonth is an instance of the DriverType declared there. The type
         model's design is handed to the generator as well so it resolves those
         references from the design itself; no code is generated for it, because the
         referenced library already carries the types under the same C# namespace. -->
    <AdditionalFiles Include="Instances\ModelDesign2.xml" />
    <AdditionalFiles Include="Instances\ModelDesign2.csv" />
    <AdditionalFiles Include="..\Common\Types\ModelDesign1.xml" Link="Instances\ModelDesign1.xml" />
    <AdditionalFiles Include="..\Common\Types\ModelDesign1.csv" Link="Instances\ModelDesign1.csv" />
    <None Include="..\README.md">
      <Link>README.md</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Samples\ServerControls.Net4\UA Server Controls.csproj" />
    <ProjectReference Include="..\..\..\Samples\Hosting\Opc.Ua.Samples.Hosting.csproj" />
    <ProjectReference Include="..\Common\DataTypes Library.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server">
      <Version>$(OpcUaNetStandardVersion)</Version>
    </PackageReference>

    <PackageReference
      Include="OPCFoundation.NetStandard.Opc.Ua.SourceGeneration"
      Version="$(OpcUaNetStandardVersion)"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
