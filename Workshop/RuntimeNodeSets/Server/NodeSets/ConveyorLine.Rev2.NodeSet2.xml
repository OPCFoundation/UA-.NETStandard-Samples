  <UADataType NodeId="ns=1;i=1000" BrowseName="1:ConveyorState">
    <DisplayName>ConveyorState</DisplayName>
    <Description>The operating state of a conveyor.</Description>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=29</Reference>
    </References>
    <!-- Identical to revision 1, and it has to be: the server refuses a reload which
         changes the definition of a DataType it already published, because a Client may
         have decoded values against the old one. Adding a field here is refused with
         "Runtime DataType definitions are immutable for the server lifetime". A model
         which needs a different structure declares a new DataType. -->
    <Definition Name="1:ConveyorState">
      <Field Name="Stopped" Value="0" />
      <Field Name="Running" Value="1" />
      <Field Name="Faulted" Value="2" />
    </Definition>
  </UADataType>

