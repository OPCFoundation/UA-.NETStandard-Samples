  <UAVariable NodeId="ns=1;i=5021" BrowseName="InputArguments" ParentNodeId="ns=1;i=5020" DataType="Argument" ValueRank="1" ArrayDimensions="1">
    <DisplayName>InputArguments</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">PropertyType</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=5020</Reference>
    </References>
    <Value>
      <uax:ListOfExtensionObject>
