  <NamespaceUris>
    <Uri>http://opcfoundation.org/UA/Quickstarts/RuntimeNodeSets/Site/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://opcfoundation.org/UA/Quickstarts/RuntimeNodeSets/Site/" Version="1.0.0" PublicationDate="2026-01-15T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.04" PublicationDate="2024-04-25T00:00:00Z" />
    </Model>
  </Models>
  <Aliases>
