<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- The OPC UA .NET Standard version the samples build against. Releases come
         from nuget.org, previews from the OPC Foundation GitHub Packages feed, see
         Nuget.Config. -->
    <OpcUaNetStandardVersion>2.0.2</OpcUaNetStandardVersion>
    <!-- Microsoft.Extensions.* and EF Core follow the .NET 11 release train. The
         OPC UA stack only asks for Microsoft.Extensions 10.0.x as a minimum, so the
         11.0.x packages are a plain upgrade of its dependency graph. -->
    <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
    <EntityFrameworkCoreVersion>11.0.0</EntityFrameworkCoreVersion>
  </PropertyGroup>

  <!-- The GitHub Packages feed requires credentials, so it is only consulted when a
       preview is referenced (a version with a prerelease label, e.g.
       2.0.334.14261-preview). A release restores from nuget.org alone through
       Nuget.Release.Config and needs no credentials, locally or in CI. A restore
       that names its own config file (the configfile option of dotnet restore, which
       the DotNetCoreCLI restore command always passes) overrides this. -->
  <PropertyGroup Condition="!$(OpcUaNetStandardVersion.Contains('-'))">
    <RestoreConfigFile>$(MSBuildThisFileDirectory)Nuget.Release.Config</RestoreConfigFile>
  </PropertyGroup>

  <Choose>
    <!-- .NET 4.8 is only available on Windows builds,
          however for mono builds on linux it can be enabled.
          msbuild ... /p:MonoBuild=true ...
      -->
    <When Condition="$([MSBuild]::IsOsPlatform('Windows')) OR ('$(MonoBuild)' == 'true')">
      <PropertyGroup>
        <DotNetTargetFramework>net48;</DotNetTargetFramework>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <DotNetTargetFramework></DotNetTargetFramework>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <AppTargetFrameworks>$(DotNetTargetFramework)net11.0</AppTargetFrameworks>
    <AppTargetFramework>net11.0</AppTargetFramework>
    <TestsTargetFrameworks>$(DotNetTargetFramework)net11.0</TestsTargetFrameworks>
    <LibTargetFrameworks>$(DotNetTargetFramework)net11.0</LibTargetFrameworks>
    <LibxTargetFrameworks>$(DotNetTargetFramework)net11.0</LibxTargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <AnalysisLevel>preview-all</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
    <AnalysisModeStyle>default</AnalysisModeStyle>
  </PropertyGroup>

  <ItemGroup Condition="$(NO_RCS) == ''">
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>

</Project>
