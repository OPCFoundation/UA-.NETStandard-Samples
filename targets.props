<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- The OPC UA .NET Standard preview version the samples build against. The
         packages come from the OPC Foundation GitHub Packages feed, see Nuget.Config. -->
    <OpcUaNetStandardVersion>2.0.262.32744-preview</OpcUaNetStandardVersion>
  </PropertyGroup>

  <Choose>
    <!-- .NET 4.8 is only available on Windows builds,
          however for mono builds on linux it can be enabled.
          msbuild ... /p:MonoBuild=true ...
      -->
    <When Condition="$([MSBuild]::IsOsPlatform('Windows')) OR ('$(MonoBuild)' == 'true')">
      <PropertyGroup>
        <DotNetTargetFramework>net48;</DotNetTargetFramework>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <DotNetTargetFramework></DotNetTargetFramework>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <AppTargetFrameworks>$(DotNetTargetFramework)net8.0;net10.0</AppTargetFrameworks>
    <AppTargetFramework>net10.0</AppTargetFramework>
    <TestsTargetFrameworks>$(DotNetTargetFramework)net8.0;net10.0</TestsTargetFrameworks>
    <LibTargetFrameworks>$(DotNetTargetFramework)netstandard2.1;net8.0;net10.0</LibTargetFrameworks>
    <LibxTargetFrameworks>$(DotNetTargetFramework)netstandard2.1;net8.0;net10.0</LibxTargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <AnalysisLevel>preview-all</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
    <AnalysisModeStyle>default</AnalysisModeStyle>
  </PropertyGroup>

  <ItemGroup Condition="$(NO_RCS) == ''">
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

</Project>
