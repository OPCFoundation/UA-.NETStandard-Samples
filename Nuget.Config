<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Preview packages of the OPC UA .NET Standard stack, published by the
         nuget-publish workflow of OPCFoundation/UA-.NETStandard on every master
         build. GitHub Packages requires authentication even for public feeds:
         use a personal access token with read:packages scope, see README.md. -->
    <add key="opcfoundation-github" value="https://nuget.pkg.github.com/OPCFoundation/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
