<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The package sources of a build against a released OPC UA .NET Standard version:
       nuget.org alone, so the restore needs no credentials. targets.props selects this
       file (RestoreConfigFile) unless OpcUaNetStandardVersion is a preview; a preview
       restores through Nuget.Config, which adds the OPC Foundation GitHub Packages feed. -->
  <packageSources>
    <clear/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
