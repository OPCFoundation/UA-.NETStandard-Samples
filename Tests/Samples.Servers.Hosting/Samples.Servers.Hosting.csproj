<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- the sample servers are WinForms executables, so anything referencing them
         has to target the windows flavour, even though no window is ever created -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Opc.Ua.Samples.Tests</RootNamespace>
    <AssemblyName>Samples.Servers.Hosting</AssemblyName>
    <Description>References every sample server and knows how each one creates its server instance.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Samples.Tests.Common\Samples.Tests.Common.csproj" />
  </ItemGroup>

  <!-- the sample servers which can be started headless -->
  <ItemGroup>
    <ProjectReference Include="..\..\Workshop\AlarmCondition\Server\AlarmCondition Server.csproj" />
    <ProjectReference Include="..\..\Workshop\Boiler\Server\Boiler Server.csproj" />
    <ProjectReference Include="..\..\Workshop\DataAccess\Server\DataAccess Server.csproj" />
    <ProjectReference Include="..\..\Workshop\DataTypes\Server\DataTypes Server.csproj" />
    <ProjectReference Include="..\..\Workshop\Empty\Server\Empty Server.csproj" />
    <ProjectReference Include="..\..\Workshop\HistoricalAccess\Server\HistoricalAccess Server.csproj" />
    <ProjectReference Include="..\..\Workshop\HistoricalEvents\Server\HistoricalEvents Server.csproj" />
    <ProjectReference Include="..\..\Workshop\Methods\Server\Methods Server.csproj" />
    <ProjectReference Include="..\..\Workshop\PerfTest\Server\PerfTest Server.csproj" />
    <ProjectReference Include="..\..\Workshop\SimpleEvents\Server\SimpleEvents Server.csproj" />
    <ProjectReference Include="..\..\Workshop\StateMachines\Server\StateMachines Server.csproj" />
    <ProjectReference Include="..\..\Workshop\UserAuthentication\Server\UserAuthentication Server.csproj" />
    <ProjectReference Include="..\..\Workshop\Views\Server\Views Server.csproj" />
    <!-- the console aggregation server compiles the very same sources, so hosting this
         project covers both variants of that sample -->
    <ProjectReference Include="..\..\Workshop\Aggregation\Server\Aggregation Server.csproj" />
    <ProjectReference Include="..\..\Samples\ReferenceServer\Reference Server.csproj" />
    <ProjectReference Include="..\..\Samples\Server.Net4\UA Sample Server.csproj" />
  </ItemGroup>

</Project>
