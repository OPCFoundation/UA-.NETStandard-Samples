<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Opc.Ua.Samples.Tests</RootNamespace>
    <AssemblyName>Samples.Tests.Common</AssemblyName>
    <Description>Helpers shared by all sample test projects: repository layout, the sample catalog, headless sample server hosting and a plain OPC UA test client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="$(OpcUaNetStandardVersion)" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="$(OpcUaNetStandardVersion)" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="$(OpcUaNetStandardVersion)" />
  </ItemGroup>

</Project>
