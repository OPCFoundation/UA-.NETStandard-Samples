<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- tier 0 needs neither WinForms nor a network, keep it portable -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Opc.Ua.Samples.Tests</RootNamespace>
    <AssemblyName>SampleConfiguration.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <Description>Tier 0: validates the configuration files and endpoint urls of all samples.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Samples.Tests.Common\Samples.Tests.Common.csproj" />
  </ItemGroup>

</Project>
