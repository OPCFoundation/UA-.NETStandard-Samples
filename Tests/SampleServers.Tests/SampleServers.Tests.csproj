<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Opc.Ua.Samples.Tests</RootNamespace>
    <AssemblyName>SampleServers.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <Description>Tier 1: starts every sample server headless and connects to it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Samples.Tests.Common\Samples.Tests.Common.csproj" />
    <ProjectReference Include="..\Samples.Servers.Hosting\Samples.Servers.Hosting.csproj" />
  </ItemGroup>

  <!-- the console samples are started as the processes they are, so they only have to be
       built, not referenced. They also target their own frameworks. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Samples\LDS\ConsoleServer\ConsoleLds.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\Samples\GDS\ConsoleServer\NetCoreGlobalDiscoveryServer.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\Workshop\Aggregation\ConsoleAggregationServer\ConsoleAggregationServer.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
